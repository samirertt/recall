# Copy to .env and fill in what you need. All variables are optional — sensible
# local-first defaults apply if unset. See backend/app/core/config.py for the
# authoritative list.

# Where the canonical SQLite file and attachments live (defaults under ./data/).
# ENGMEM_DATA_DIR=./data
# ENGMEM_DATABASE_PATH=./data/engineering.db
# ENGMEM_ATTACHMENTS_DIR=./data/attachments

# AI enrichment provider: heuristic (default, no API key needed) | claude | openai_compatible
# ENGMEM_AI_PROVIDER=heuristic
# ENGMEM_ANTHROPIC_API_KEY=sk-ant-...
# ENGMEM_OPENAI_API_KEY=sk-...
# ENGMEM_OPENAI_API_BASE=https://api.openai.com/v1   # or a self-hosted/Ollama/vLLM endpoint

# Embeddings auto-detect availability (BAAI/bge-small-en-v1.5 via fastembed).
# Set to false to force lexical-only search even if the model is available.
# ENGMEM_EMBEDDINGS_ENABLED=true

# Frontend origins allowed to call the API in dev (comma-separated JSON list).
# ENGMEM_CORS_ORIGINS=["http://localhost:5173"]
